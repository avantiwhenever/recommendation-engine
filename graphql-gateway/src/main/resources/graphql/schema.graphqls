type Product {
    productId: ID!
    name: String!
    productClass: String
    categoryHierarchy: String
    averageRating: Float
    ratingCount: Int
    score: Float!
    source: String!
}

enum RecommenderStrategy {
    NONE
    POPULARITY
    COLLABORATIVE
    BANDIT
    NEURAL
    DIVERSE_POPULARITY
}

type SearchResult {
    query: String!
    strategy: RecommenderStrategy!
    products: [Product!]!
}

type Query {
    # recentProductIds: product IDs the user interacted with in the current
    # browsing session (distinct from userId's all-time history) — feeds
    # CollaborativeFilteringStrategy/NeuralRankingStrategy's session-recency
    # weighting. Optional; defaults to no session signal.
    #
    # categoryFilter/minRating: a hard eligibility filter applied before
    # scoring, distinct from the widen-then-select multi-stage pipeline
    # and from any strategy's own reranking. Both optional; omitting
    # either means "no filter".
    #
    # topK is capped by the multi-stage pipeline's internal candidate-pool
    # size (see SearchOrchestrationUseCase#ELIGIBLE_POOL_SIZE, currently
    # 50) — requesting more than that silently returns fewer results, not
    # an error.
    search(query: String!, topK: Int = 10, strategy: RecommenderStrategy = COLLABORATIVE, userId: String,
           recentProductIds: [ID!] = [], categoryFilter: String, minRating: Float): SearchResult!
}
