type Product {
    productId: ID!
    name: String!
    productClass: String
    categoryHierarchy: String
    averageRating: Float
    ratingCount: Int
    score: Float!
    source: String!
}

enum RecommenderStrategy {
    NONE
    POPULARITY
    COLLABORATIVE
    BANDIT
    NEURAL
}

type SearchResult {
    query: String!
    strategy: RecommenderStrategy!
    products: [Product!]!
}

type Query {
    search(query: String!, topK: Int = 10, strategy: RecommenderStrategy = COLLABORATIVE, userId: String): SearchResult!
}
