<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.avanti.recengine</groupId>
  <artifactId>recengine-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Recommendation Engine</name>
  <description>Hexagonal-architecture, gRPC-based recommendation engine over the WANDS product catalog, with a GraphQL gateway serving a React UI.</description>

  <modules>
    <module>rec-support</module>
    <module>search-service</module>
    <module>recommender-service</module>
    <module>graphql-gateway</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Latest JDK, matching the sibling `search` project's choice. -->
    <maven.compiler.release>26</maven.compiler.release>

    <!-- gRPC / Protobuf: pinned to what grpc-protobuf itself depends on
         (protobuf-java) rather than the latest protobuf-java, so the protoc
         codegen and the runtime classpath agree with what grpc-java was
         actually built and tested against. 1.83.1 (not the 1.73.0 this
         project started on) — CI's cve-scan and docker-image-scan jobs
         caught a real HIGH-severity CVE-2025-55163 (Netty HTTP/2 DDoS) in
         1.73.0's transitive netty-codec-http2, fixed upstream by 1.75.0+. -->
    <grpc.version>1.83.1</grpc.version>
    <protobuf.version>3.25.9</protobuf.version>
    <protobuf-plugin.version>0.6.1</protobuf-plugin.version>
    <os-maven-plugin.version>1.7.1</os-maven-plugin.version>
    <grpc-spring-boot-starter.version>3.1.0.RELEASE</grpc-spring-boot-starter.version>

    <onnxruntime.version>1.29.0</onnxruntime.version>
    <djl-tokenizers.version>0.36.0</djl-tokenizers.version>
    <!-- Pinecone Local (docs.pinecone.io) is a fixed emulator on API version
         2025-01 whose index-describe responses lack the `vector_type` field
         that pinecone-client 4.x+ requires and fails to deserialize without
         (verified directly against the jar — IndexModel.class first
         references `vector_type` starting at 4.0.0). 3.1.0 is the newest
         version that still works against Pinecone Local. -->
    <pinecone-client.version>3.1.0</pinecone-client.version>
    <commons-csv.version>1.14.1</commons-csv.version>

    <spring-boot.version>3.5.16</spring-boot.version>
    <!-- Must match (or be omitted in favor of) spring-boot-dependencies:3.5.16's
         own managed version. 1.3.3 was found to pull an incompatible
         transitive org.dataloader:java-dataloader that breaks
         GraphQlAutoConfiguration at startup (NoSuchMethodError on
         DataLoaderOptions.newOptions()) — discovered and fixed while
         building graphql-gateway. -->
    <spring-graphql.version>1.4.6</spring-graphql.version>
    <picocli.version>4.7.7</picocli.version>
    <slf4j.version>2.0.18</slf4j.version>
    <junit.version>5.14.4</junit.version>
    <assertj.version>3.27.7</assertj.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Internal modules -->
      <dependency>
        <groupId>com.avanti.recengine</groupId>
        <artifactId>rec-support</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- gRPC + Protobuf -->
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Transitive-only pin: io.pinecone:pinecone-client pulls the
           non-shaded io.grpc:grpc-netty (grpc-netty-shaded's own bundled
           netty is relocated/isolated and unaffected), which resolves to a
           netty version with several real HIGH-severity CVEs
           (CVE-2026-59901, -55831, -55833, -56745, -56819 — DoS/infinite
           loop in netty-codec/-http/-http2) that grpc 1.83.1 hasn't picked
           up yet. Overriding via netty-bom to the newest patched release in
           the same 4.1.x line grpc/pinecone-client were built against,
           rather than jumping to the 4.2.x line, which is a real breaking
           change. Caught by CI's docker-image-scan job, not guessed. -->
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>4.2.17.Final</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Transitive-only pins: pinecone-client's own control-plane API
           client (org.openapitools:jackson-databind-nullable and its own
           deps) pulls jackson-databind and log4j-api versions with real
           MEDIUM-severity CVEs (CVE-2026-54515/-59889/GHSA-mhm7-754m-9p8w;
           CVE-2026-49844 respectively) — found via `./scripts/scan-cves.sh`,
           the same local-reproduction workflow that caught the netty CVEs
           above. Pinned to the newest fixed release in the same line
           already resolved (jackson) or the sibling `search` project's own
           already-vetted pin (log4j, same version it uses). -->
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>2.22.2</version>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-api</artifactId>
        <version>2.26.1</version>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat</groupId>
        <artifactId>annotations-api</artifactId>
        <version>6.0.53</version>
      </dependency>

      <!-- ONNX Runtime + tokenizers (client-side embeddings, since Pinecone
           Local has no integrated inference) -->
      <dependency>
        <groupId>com.microsoft.onnxruntime</groupId>
        <artifactId>onnxruntime</artifactId>
        <version>${onnxruntime.version}</version>
      </dependency>
      <dependency>
        <groupId>ai.djl.huggingface</groupId>
        <artifactId>tokenizers</artifactId>
        <version>${djl-tokenizers.version}</version>
      </dependency>

      <!-- Pinecone -->
      <dependency>
        <groupId>io.pinecone</groupId>
        <artifactId>pinecone-client</artifactId>
        <version>${pinecone-client.version}</version>
      </dependency>

      <!-- Data / CSV -->
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-csv</artifactId>
        <version>${commons-csv.version}</version>
      </dependency>

      <!-- CLI -->
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>

      <!-- Logging -->
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>

      <!-- Spring Boot (leaf adapters only — never domain/application/port) -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.graphql</groupId>
        <artifactId>spring-graphql</artifactId>
        <version>${spring-graphql.version}</version>
      </dependency>
      <dependency>
        <groupId>net.devh</groupId>
        <artifactId>grpc-server-spring-boot-starter</artifactId>
        <version>${grpc-spring-boot-starter.version}</version>
      </dependency>
      <dependency>
        <groupId>net.devh</groupId>
        <artifactId>grpc-client-spring-boot-starter</artifactId>
        <version>${grpc-spring-boot-starter.version}</version>
      </dependency>

      <!-- Test -->
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <extensions>
      <extension>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>${os-maven-plugin.version}</version>
      </extension>
    </extensions>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.15.0</version>
          <configuration>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.6</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.2</version>
        </plugin>
        <plugin>
          <groupId>org.xolstice.maven.plugins</groupId>
          <artifactId>protobuf-maven-plugin</artifactId>
          <version>${protobuf-plugin.version}</version>
          <configuration>
            <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
            <pluginId>grpc-java</pluginId>
            <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
            <protoSourceRoot>${project.basedir}/../proto</protoSourceRoot>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>compile</goal>
                <goal>compile-custom</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
