<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.avanti.recengine</groupId>
  <artifactId>recengine-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Recommendation Engine</name>
  <description>Hexagonal-architecture, gRPC-based recommendation engine over the WANDS product catalog, with a GraphQL gateway serving a React UI.</description>

  <modules>
    <module>rec-support</module>
    <module>search-service</module>
    <module>recommender-service</module>
    <module>graphql-gateway</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Latest JDK, matching the sibling `search` project's choice. -->
    <maven.compiler.release>26</maven.compiler.release>

    <!-- gRPC / Protobuf: pinned to what grpc-protobuf itself depends on
         (protobuf-java) rather than the latest protobuf-java, so the protoc
         codegen and the runtime classpath agree with what grpc-java was
         actually built and tested against. 1.83.1 (not the 1.73.0 this
         project started on) — CI's cve-scan and docker-image-scan jobs
         caught a real HIGH-severity CVE-2025-55163 (Netty HTTP/2 DDoS) in
         1.73.0's transitive netty-codec-http2, fixed upstream by 1.75.0+. -->
    <grpc.version>1.83.1</grpc.version>
    <protobuf.version>3.25.9</protobuf.version>
    <protobuf-plugin.version>0.6.1</protobuf-plugin.version>
    <os-maven-plugin.version>1.7.1</os-maven-plugin.version>

    <onnxruntime.version>1.20.0</onnxruntime.version>
    <djl-tokenizers.version>0.31.1</djl-tokenizers.version>
    <!-- Pinecone Local (docs.pinecone.io) is a fixed emulator on API version
         2025-01 whose index-describe responses lack the `vector_type` field
         that pinecone-client 4.x+ requires and fails to deserialize without
         (verified directly against the jar — IndexModel.class first
         references `vector_type` starting at 4.0.0). 3.1.0 is the newest
         version that still works against Pinecone Local. -->
    <pinecone-client.version>3.1.0</pinecone-client.version>
    <commons-csv.version>1.11.0</commons-csv.version>

    <!-- Spring Boot 4 / Spring Framework 7: Spring Framework 6.2.x has no
         open-source fix for CRITICAL CVE-2026-47884/-47890 in spring-webmvc
         (fixed in 7.0.9). Boot 4 also ships first-party gRPC starters, which
         replaced the net.devh grpc-spring-boot-starter (Boot 3 only). Spring
         GraphQL, JUnit and AssertJ versions come from Boot's own BOM. -->
    <spring-boot.version>4.1.1</spring-boot.version>
    <tomcat.version>11.0.27</tomcat.version>
    <!-- Two Jackson lines coexist: Jackson 2 (com.fasterxml), still used
         transitively by pinecone-client, and Jackson 3 (tools.jackson), used
         by Spring Boot 4 itself. Both share jackson-annotations 2.21. -->
    <jackson2.version>2.21.7</jackson2.version>
    <jackson3.version>3.1.7</jackson3.version>
    <picocli.version>4.7.6</picocli.version>
    <slf4j.version>2.0.16</slf4j.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Internal modules -->
      <dependency>
        <groupId>com.avanti.recengine</groupId>
        <artifactId>rec-support</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- gRPC + Protobuf -->
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Transitive-only pin: io.pinecone:pinecone-client pulls the
           non-shaded io.grpc:grpc-netty (grpc-netty-shaded's own bundled
           netty is relocated/isolated and unaffected), which resolves to a
           netty version with several real HIGH-severity CVEs
           (CVE-2026-59901, -55831, -55833, -56745, -56819 — DoS/infinite
           loop in netty-codec/-http/-http2) that grpc 1.83.1 hasn't picked
           up yet. Overriding via netty-bom to the newest patched release in
           the same 4.1.x line grpc/pinecone-client were built against,
           rather than jumping to the 4.2.x line, which is a real breaking
           change. Caught by CI's docker-image-scan job, not guessed. -->
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>4.1.137.Final</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Transitive-only pins: pinecone-client's own control-plane API
           client (org.openapitools:jackson-databind-nullable and its own
           deps) pulls jackson-databind and log4j-api versions with real
           MEDIUM-severity CVEs (CVE-2026-54515/-59889/GHSA-mhm7-754m-9p8w;
           CVE-2026-49844 respectively) — found via `./scripts/scan-cves.sh`,
           the same local-reproduction workflow that caught the netty CVEs
           above. Pinned to the newest fixed release in the same line
           already resolved (jackson) or the sibling `search` project's own
           already-vetted pin (log4j, same version it uses). Jackson is
           pinned via its BOM so jackson-core moves in lockstep with
           jackson-databind — pinning databind alone left jackson-core on a
           version with its own HIGH CVEs (CVE-2026-89407/-89425, plus
           databind's CVE-2026-91776/-91777, all fixed in 2.21.7). The same
           CVEs affect Jackson 3, whose Spring Boot 4.1.1-managed 3.1.5 is
           overridden to the fixed 3.1.7 the same way. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson2.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>tools.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson3.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-api</artifactId>
        <version>2.26.1</version>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat</groupId>
        <artifactId>annotations-api</artifactId>
        <version>6.0.53</version>
      </dependency>

      <!-- ONNX Runtime + tokenizers (client-side embeddings, since Pinecone
           Local has no integrated inference) -->
      <dependency>
        <groupId>com.microsoft.onnxruntime</groupId>
        <artifactId>onnxruntime</artifactId>
        <version>${onnxruntime.version}</version>
      </dependency>
      <dependency>
        <groupId>ai.djl.huggingface</groupId>
        <artifactId>tokenizers</artifactId>
        <version>${djl-tokenizers.version}</version>
      </dependency>

      <!-- Pinecone -->
      <dependency>
        <groupId>io.pinecone</groupId>
        <artifactId>pinecone-client</artifactId>
        <version>${pinecone-client.version}</version>
      </dependency>

      <!-- Data / CSV -->
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-csv</artifactId>
        <version>${commons-csv.version}</version>
      </dependency>

      <!-- CLI -->
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>

      <!-- Logging -->
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>

      <!-- Embedded Tomcat, overriding Spring Boot 4.1.1's managed 11.0.24:
           CRITICAL CVE-2026-65182/-65905/-68525 (security-constraint and
           authentication bypasses), fixed in 11.0.25. Declared before the
           spring-boot-dependencies import so these entries take precedence.
           Remove once a Spring Boot release manages a fixed version. -->
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-core</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-el</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-websocket</artifactId>
        <version>${tomcat.version}</version>
      </dependency>

      <!-- Spring Boot (leaf adapters only — never domain/application/port) -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <extensions>
      <extension>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>${os-maven-plugin.version}</version>
      </extension>
    </extensions>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
        <plugin>
          <groupId>org.xolstice.maven.plugins</groupId>
          <artifactId>protobuf-maven-plugin</artifactId>
          <version>${protobuf-plugin.version}</version>
          <configuration>
            <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
            <pluginId>grpc-java</pluginId>
            <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
            <protoSourceRoot>${project.basedir}/../proto</protoSourceRoot>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>compile</goal>
                <goal>compile-custom</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
